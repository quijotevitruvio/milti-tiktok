{
  "manifest_version": 3,
  "name": "MultiTikTok",
  "version": "0.5.0",
  "minimum_chrome_version": "130",
  "description": "Cambia entre tus sesiones de TikTok en Chrome.",
  "permissions": ["storage", "cookies", "scripting", "sidePanel", "alarms"],
  "optional_host_permissions": ["https://*.tiktok.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://*.tiktokcdn.com https://*.tiktokcdn-us.com https://*.tiktokcdn-eu.com"
  },
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": {
    "default_title": "MultiTikTok",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+M" }
    },
    "open-previous-account": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Volver a la cuenta anterior de TikTok"
    },
    "open-favorite-account": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Abrir la cuenta favorita elegida en MultiTikTok"
    }
  },
  "incognito": "not_allowed"
}
